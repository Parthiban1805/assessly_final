# Stage 1: Create the Conda Environment
FROM continuumio/miniconda3:4.12.0 AS builder

# Set working directory
WORKDIR /app

# Install system dependencies
RUN \
    sed -i 's/deb.debian.org/cdn-fastly.deb.debian.org/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y \
        build-essential \
        libsndfile1 \
        libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Copy conda environment file and create the environment
COPY proctor_env.yml .
RUN conda env create -f proctor_env.yml -n proctor-final

# Stage 2: Final Image
FROM continuumio/miniconda3:4.12.0

# Set working directory
WORKDIR /app

# Install system dependencies again for runtime
RUN \
    sed -i 's/deb.debian.org/cdn-fastly.deb.debian.org/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y \
        libsndfile1 \
        libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Copy Conda environment from builder
COPY --from=builder /opt/conda/envs/proctor-final /opt/conda/envs/proctor-final

# Ensure the Conda environment is used
ENV PATH="/opt/conda/envs/proctor-final/bin:$PATH"

# Copy application source code
COPY . .

# 🔥 Copy YOLO model files explicitly if in subfolder (replace path if different)
COPY model/ ./model/

# Expose the application's port
EXPOSE 5001

# Start the Gunicorn server
CMD ["gunicorn", "proctor:app", "--workers", "2", "--timeout", "120", "--bind", "0.0.0.0:5001"]
