# Stage 1: Create the Conda Environment
# Use an official Miniconda image as a base.
FROM continuumio/miniconda3:4.12.0 AS builder

# Set the working directory
WORKDIR /app

# --- FIX FOR NETWORKING AND PERMISSIONS ---
# 1. Install required system libraries with retries
USER root
RUN \
    sed -i 's/deb.debian.org/cdn-fastly.deb.debian.org/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y \
        build-essential \
        libsndfile1 \
        libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy the environment file and create the Conda environment
COPY proctor_env.yml .
RUN conda env create -f proctor_env.yml -n proctor-final

# Stage 2: Build the final application image
FROM continuumio/miniconda3:4.12.0

# Set the working directory
WORKDIR /app

# Install required system libraries in the final image
USER root
RUN \
    sed -i 's/deb.debian.org/cdn-fastly.deb.debian.org/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y \
        libsndfile1 \
        libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Copy the Conda environment from the builder stage
COPY --from=builder /opt/conda/envs/proctor-final /opt/conda/envs/proctor-final

# Copy all application code
COPY . .

# Expose the application port
EXPOSE 5001

# Set the environment path explicitly (important when not using `conda activate`)
ENV PATH="/opt/conda/envs/proctor-final/bin:$PATH"

# Command to run the application using Gunicorn
CMD ["gunicorn", "proctor:app", "--workers", "2", "--timeout", "120", "--bind", "0.0.0.0:5001"]
