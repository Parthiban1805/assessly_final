# Stage 1: Create the Conda Environment
# Use an official Miniconda image as a base.
FROM continuumio/miniconda3:4.12.0 AS builder

# Set the working directory
WORKDIR /app

# --- THE DEFINITIVE FIX for flaky networks ---
# 1. Switch to the root user to install system packages.
USER root

# 2. Modify the sources.list to use a CDN mirror and add retry logic to the apt-get command.
RUN \
    sed -i 's/deb.debian.org/cdn-fastly.deb.debian.org/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y sudo build-essential && \
    rm -rf /var/lib/apt/lists/*

# 3. Give the 'conda' user passwordless sudo privileges.
RUN echo "conda ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# 4. Switch back to the standard conda user.
USER conda

# --- END OF FIX ---

# Copy ONLY the environment file first. This leverages Docker's layer caching.
COPY proctor_env.yml .

# Create the Conda environment. This is now run as the correct 'conda' user.
RUN conda env create -f proctor_env.yml

# Stage 2: Build the final application image
# Start from a fresh Miniconda image again to keep the final image clean
FROM continuumio/miniconda3:4.12.0

# Set the working directory
WORKDIR /app

# Copy the entire Conda environment created in the 'builder' stage.
# IMPORTANT: This assumes the 'name:' field in your proctor_env.yml is 'proctor-final'.
COPY --from=builder /opt/conda/envs/proctor-final /opt/conda/envs/proctor-final

# Copy all your application code (all .py files, models folder, etc.)
COPY . .

# Expose the port that your Flask application runs on
EXPOSE 5001

# The command to run your application using a production-grade server (Gunicorn).
# We use the full, absolute path to gunicorn inside the Conda environment.
CMD ["/opt/conda/envs/proctor-final/bin/gunicorn", "proctor:app", "--workers", "2", "--timeout", "120", "--bind", "0.0.0.0:5001"]