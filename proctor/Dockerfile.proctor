# Stage 1: Create the Conda Environment
# Use an official Miniconda image as a base.
FROM continuumio/miniconda3:4.12.0 AS builder

# Set the working directory
WORKDIR /app

# --- DEFINITIVE FIX ---
# Run everything as the default ROOT user. This avoids all user-switching problems.
# Install all required system libraries.
RUN apt-get update && apt-get install -y \
    build-essential \
    libsndfile1 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*
# --- END OF FIX ---

# Copy the environment file.
COPY proctor_env.yml .

# Create the Conda environment. This is run as root, which is fine for the build stage.
RUN conda env create -f pro-final.yml

# Stage 2: Build the final application image
# Start from a fresh Miniconda image again to keep the final image clean.
FROM continuumio/miniconda3:4.12.0

# Set the working directory
WORKDIR /app

# Install the required system libraries in the final image as well.
# We must do this as root.
USER root
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Copy the entire Conda environment from the 'builder' stage.
COPY --from=builder /opt/conda/envs/proctor-final /opt/conda/envs/proctor-final

# Copy all application code.
COPY . .

# Expose the application port.
EXPOSE 5001

# The command to run the application using Gunicorn.
CMD ["/opt/conda/envs/proctor-final/bin/gunicorn", "proctor:app", "--workers", "2", "--timeout", "120", "--bind", "0.0.0.0:5001"]