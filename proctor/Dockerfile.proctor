# Stage 1: Create the Conda Environment
# Use an official Miniconda image as a base. It's smaller than full Anaconda.
FROM continuumio/miniconda3:4.12.0 AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy ONLY the environment file first. This takes advantage of Docker's layer caching.
# If you don't change the environment, this long step won't re-run on future builds.
COPY proctor_env.yml .

# Create the Conda environment from your YAML file.
# This is the most time-consuming step and will run only when proctor_env.yml changes.
RUN conda env create -f proctor_env.yml

# Stage 2: Build the final application image
# Start from a fresh Miniconda image again to keep the final image clean
FROM continuumio/miniconda3:4.12.0

# Set the working directory
WORKDIR /app

# --- CRITICAL STEP ---
# The line below assumes the 'name:' field in your proctor_env.yml is 'proctor-final'.
# If your YML file has a different name (e.g., 'name: my-env'), you MUST change the path here
# to match it (e.g., /opt/conda/envs/my-env).
COPY --from=builder /opt/conda/envs/proctor-final /opt/conda/envs/proctor-final

# Copy all your application code (all .py files, models folder, etc.)
COPY . .

# Expose the port that your Flask application runs on
EXPOSE 5001

# The command to run your application using a production-grade server (Gunicorn).
# We now use the full, absolute path to gunicorn inside the Conda environment to ensure it's found.
# Again, ensure 'proctor-final' in the path below matches the name in your YML file.
CMD ["/opt/conda/envs/proctor-final/bin/gunicorn", "proctor:app", "--workers", "2", "--timeout", "120", "--bind", "0.0.0.0:5001"]