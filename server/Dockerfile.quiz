# Use an official lightweight Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory inside the container
WORKDIR /app

# Set environment variables to prevent Python from buffering stdout and stderr
ENV PYTHONUNBUFFERED 1

# Install Python dependencies
# Copy the requirements file first to leverage Docker's layer caching
COPY requirements-quiz.txt .
RUN pip install --no-cache-dir -r requirements-quiz.txt

# Copy the Python source code for the quiz service
COPY main.py .
COPY ./core ./core

# Expose the port the service runs on
EXPOSE 8000

# We comment out the original command to keep the container running for inspection
# CMD ["/usr/local/bin/gunicorn", "main:app", "--workers", "2", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]

# Add a command that will run forever, allowing us to exec into the container
CMD ["tail", "-f", "/dev/null"]