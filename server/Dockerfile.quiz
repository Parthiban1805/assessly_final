# File: server/Dockerfile.quiz (Final and Correct)

# Use an official lightweight Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory inside the container
WORKDIR /app

# Set environment variables to prevent Python from buffering stdout and stderr
ENV PYTHONUNBUFFERED 1

# --- THIS IS WHERE GUNICORN GETS INSTALLED ---
# Copy the requirements file (which now includes gunicorn)
COPY requirements-quiz.txt .
# Run pip to install all packages
RUN pip install --no-cache-dir -r requirements-quiz.txt

# Copy the application source code
COPY main.py .
COPY ./core ./core

# Expose the port the service will run on
EXPOSE 8000

# --- THIS IS WHERE GUNICORN IS RUN ---
# The command to run the application using the absolute path to Gunicorn.
CMD ["/usr/local/bin/gunicorn", "main:app", "--workers", "2", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]